# =============================================================================
# Root .env — used by docker-compose.yml (Postgres bootstrap)
#
# Copy to ``./.env`` and fill in real values. Don't commit the populated file.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (shared by api-server and MCP servers)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
