# =============================================================================
# Root .env — used by docker-compose.yml (Postgres + Superset bootstrap)
#
# Copy to ``./.env`` and fill in real values. Don't commit the populated file.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (shared by api-server, Superset, MCP servers)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Superset bootstrap (used on first container start)
# -----------------------------------------------------------------------------
SUPERSET_DB=superset
# Generate: openssl rand -hex 32
SUPERSET_SECRET_KEY=replace-with-random-hex-64-chars
# Initial admin user created on first boot.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@localhost
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
# Fernet key for Superset's encrypted DB-credentials column.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUPERSET_PROV_KEY=replace-with-fernet-key
