# Python-generated files
__pycache__/
*.py[oc]
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
wheels/
*.egg-info/
*.egg
*.so
*.dylib

# Virtual environments
**/.venv/
**/venv/
**/ENV/
**/env/
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# User uploads and generated files
**/uploads/*
!**/uploads/.gitkeep
**/file_handle/*
!**/file_handle/.gitkeep
**/static/charts/*.png
!**/static/charts/.gitkeep

# Logs
*.log
logs/
*.log.*

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# macOs
.DS_Store

# runtime user data — keep the dirs (.gitkeep), ignore the files inside.
# (DATA_ROOT runtime data under **/_data is handled by the block below.)
test_file/*

# DATA_ROOT runtime data (./_data) — ignore the files, keep the dir skeleton via .gitkeep.
# (uploads is already handled by the **/uploads/* rule above.)
**/_data/databases/*
!**/_data/databases/.gitkeep
**/_data/temp_dbs/*
!**/_data/temp_dbs/.gitkeep
**/_data/uploads/*
!**/_data/uploads/.gitkeep

# SQLite database files (provisioned per-project + session temp dbs)
*.sqlite
*.sqlite-wal
*.sqlite-shm
/local_test_file

