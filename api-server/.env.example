# =============================================================================
# api-server/.env  — config for the FastAPI app
#
# Copy this file to ``api-server/.env`` and fill in real values. Never commit
# the populated ``.env`` (it's already in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI — required for the agent's LLM calls
# -----------------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# -----------------------------------------------------------------------------
# Google OAuth — required for login + Google Sheets MCP server
# -----------------------------------------------------------------------------
# Create OAuth client (Desktop / Web) at:
#   https://console.cloud.google.com/apis/credentials
# Scopes used (see google_oauth_repository.py): identity + spreadsheets.readonly.
# Add yourself as a Test User if app status is "Testing".
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# -----------------------------------------------------------------------------
# Server URLs
# -----------------------------------------------------------------------------
# Backend public URL (used to build the OAuth ``redirect_uri``). Must match
# the redirect URI registered in Google Console.
PUBLIC_BASE_URL=http://localhost:5001
# Frontend URL where users land after successful login.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of CORS-allowed origins (must match frontend exactly; no "*"
# when using cookies). Production example:
# CORS_ORIGINS=https://d-bee-light.vercel.app
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Session cookie — used by Starlette SessionMiddleware
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-random-hex-64-chars

# Local dev (frontend + api both on localhost, same-site enough):
# SESSION_SAME_SITE=lax
# SESSION_HTTPS_ONLY=

# Production: frontend on Vercel, API on another HTTPS host (cross-origin).
# Without these, /api/auth/me always returns authenticated:false → login loop.
# SESSION_SAME_SITE=none
# SESSION_HTTPS_ONLY=true

# -----------------------------------------------------------------------------
# Postgres — app metadata DB (users, projects, sessions, shares, …)
# -----------------------------------------------------------------------------
DB_URL=postgres://USER:PASSWORD@localhost:5432/mcp-api-server?sslmode=disable

# -----------------------------------------------------------------------------
# Redis — short-term session message stack (optional)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Token encryption — for Google OAuth tokens stored in users table
# -----------------------------------------------------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In dev, you can leave this empty (tokens stored plaintext + log warning).
# Required for production.
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Resend — transactional email for share-chat notifications
# -----------------------------------------------------------------------------
# https://resend.com/api-keys  (free tier: 3000/month, 100/day)
# Optional: if not set, share flow still works but skips email notifications.
RESEND_API_KEY=re_...
# Sender address. In dev, ``onboarding@resend.dev`` only sends to your own
# Resend account email. For prod, verify a domain at resend.com/domains and
# use noreply@yourdomain.com.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Frontend base URL used in email links (built as ``{APP_URL}/share/accept/<token>``).
APP_URL=http://localhost:5173
