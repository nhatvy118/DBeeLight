# --- App metadata DB (Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dbeelight

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5.2
ROUTER_MODEL=gpt-5.2

# --- Excel MCP server (HTTP) ---
EXCEL_MCP_URL=http://localhost:8931/mcp

# --- Storage (project SQLite files + uploaded session files) ---
# Phải là shared volume nếu chạy nhiều replica backend / excel-server.
DATA_ROOT=./_data
SQLITE_ALLOWED_DIRS=./_data/databases:./_data/temp_dbs

# --- Auth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=dev-session-secret-change-me
FRONTEND_URL=http://localhost:5173
# Invite-only access: these emails can ALWAYS sign in as admin (never lock yourself out).
# Comma-separated. Set this to your email for the first admin, then manage everyone from /admin.
BOOTSTRAP_ADMIN_EMAILS=

# --- Email mời share (tuỳ chọn; bỏ trống = không gửi email, vẫn share được qua link) ---
RESEND_API_KEY=
RESEND_FROM=noreply@dbeelight.local


# --- Tool loop ---
TOOL_RESULT_MAX_TOKENS=4000
MAX_TOOL_ITERATIONS=5

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
